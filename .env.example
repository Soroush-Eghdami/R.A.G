# Copy to .env and adjust. .env is gitignored.

# Django
SECRET_KEY=replace-me-with-a-random-string
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

# Where SQLite, uploads and Chroma live (relative to the repo root by default)
DATA_DIR=data

# llama.cpp model servers (start one server for chat and one for embeddings)
LLAMA_CPP_CHAT_BASE_URL=http://127.0.0.1:8082
LLAMA_CPP_EMBEDDING_BASE_URL=http://127.0.0.1:8083
LLAMA_CPP_CHAT_MODEL=Qwen3.5-9B
LLAMA_CPP_EMBEDDING_MODEL=nomic-embed-text-v1.5
LLAMA_CPP_CONNECT_TIMEOUT=5
LLAMA_CPP_REQUEST_TIMEOUT=600
LLAMA_CPP_CONTEXT_SIZE=0

# RAG defaults (per-knowledge-base values override these)
DEFAULT_CHUNK_SIZE=900
DEFAULT_CHUNK_OVERLAP=120
DEFAULT_TOP_K=4
DEFAULT_TEMPERATURE=0.2
DEFAULT_NUM_CTX=0
MAX_UPLOAD_SIZE_MB=50
DEFAULT_THINK=false
# Rewrite short, pronoun-heavy follow-ups before searching
REWRITE_FOLLOWUPS=true

# Frontend dev server (Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
