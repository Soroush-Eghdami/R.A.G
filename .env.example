# Copy to .env and adjust. .env is gitignored.

# Django
SECRET_KEY=replace-me-with-a-random-string
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

# Where SQLite, uploads and Chroma live (relative to the repo root by default)
DATA_DIR=data

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_REQUEST_TIMEOUT=600
# Seconds to cache the classified model list
MODEL_CACHE_TTL=30
# Cloud models are not private; hidden unless this is true
SHOW_CLOUD_MODELS=false

# RAG defaults (per-knowledge-base values override these)
DEFAULT_CHUNK_SIZE=900
DEFAULT_CHUNK_OVERLAP=120
DEFAULT_TOP_K=4
DEFAULT_TEMPERATURE=0.2
DEFAULT_NUM_CTX=8192
MAX_UPLOAD_SIZE_MB=50

# Frontend dev server (Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
